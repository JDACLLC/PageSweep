{
  "manifest_version": 3,
  "name": "PageSweep (Primary Scroll RC)",
  "description": "Release candidate: primary nested and reverse scrolling only; embedded code windows are not yet supported.",
  "version": "1.2.20",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PageSweep 1.2.20 — Primary Scroll RC",
    "default_icon": {
      "16": "icons/toolbar/mascot-glyph-16.png",
      "32": "icons/toolbar/mascot-glyph-32.png",
      "48": "icons/toolbar/mascot-glyph-48.png",
      "128": "icons/toolbar/mascot-glyph-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "about.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/progress/pagesweep-robot-body.png",
        "icons/progress/pagesweep-robot-body-cape-v2.png",
        "icons/progress/pagesweep-plume.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
