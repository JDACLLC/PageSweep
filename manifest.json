{
  "manifest_version": 3,
  "name": "PageSweep",
  "description": "Capture the whole webpage as a single PNG.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "downloads"
  ],
  "action": {
    "default_title": "PageSweep — Capture the whole page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
